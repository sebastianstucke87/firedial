{
  "name": "firedial",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "format": "prettier --write . && stylelint --fix \"src/**/*.css\"",
    "mutate": "stryker run",
    "lint": "tsc && oxlint --type-aware && prettier --check . && stylelint \"src/**/*.css\" && html-validate src && knip",
    "test": "npm run lint && npm run build && web-ext lint --source-dir dist/firefox && node --test --test-concurrency=1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "@types/selenium-webdriver": "^4.35.7",
    "chrome-webstore-upload-cli": "^4.0.2",
    "esbuild": "^0.28.2",
    "html-validate": "^11.18.0",
    "knip": "^6.44.1",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.52.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0"
  },
  "license": "MIT",
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.2"
    }
  }
}
